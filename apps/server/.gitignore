# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.test is tracked deliberately: it keeps `bun test` hermetic (forces
# in-memory DB + scratch storage dir + yt-dlp auto-fetch off) regardless of
# what the real .env has locally. Contains no secrets.
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/audio
dist/