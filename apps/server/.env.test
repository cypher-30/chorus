# Auto-loaded by `bun test` (Bun loads .env.test before .env for the test
# environment). Keeps the test suite from touching the real
# uploads/chorus.sqlite library catalog or the real uploads/ tree — tests
# that exercise real (unmocked) byte storage write into an isolated scratch
# folder instead, already covered by apps/server/uploads/* in .gitignore.
CHORUS_LIBRARY_DB_PATH=:memory:
LOCAL_STORAGE_DIR=./uploads/.test-scratch

# Real apps/server/.env on this machine has CHORUS_YTDLP_AUTO_FETCH=true
# (a developer's deliberate local opt-in) plus real yt-dlp/ffmpeg binaries
# on PATH. Without an explicit override here, any test that exercises a
# real (unmocked) resolver/queue path — e.g. queueSetReconciliation.test.ts,
# which posts to the real /queue/set handler — silently triggers a REAL
# background yt-dlp subprocess and network call against a fake test track
# title. Found via a genuine hang while adding resolverStates.test.ts (see
# PLAN.md's docs-audit pass). Force it off for every test run regardless of
# the real .env, so resolver tests stay deterministic and offline; a test
# that specifically wants auto-fetch behavior sets process.env directly and
# restores it in afterEach (see resolverStates.test.ts, ytdlp.test.ts).
CHORUS_YTDLP_AUTO_FETCH=false
