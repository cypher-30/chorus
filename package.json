{
  "name": "chorus",
  "packageManager": "bun@1.2.2",
  "scripts": {
    "build": "bunx --bun turbo run build",
    "dev": "bunx --bun turbo run dev",
    "up": "bun run scripts/dev-multidevice.mjs auto",
    "dev:multidevice": "bun run scripts/dev-multidevice.mjs auto",
    "dev:lan": "bun run scripts/dev-multidevice.mjs lan",
    "dev:tailscale": "bun run scripts/dev-multidevice.mjs tailscale",
    "storage:cleanup": "bun run --cwd apps/server storage:cleanup",
    "start": "bunx --bun turbo run start",
    "server": "bunx --bun turbo start --filter=server",
    "client": "bunx --bun turbo start --filter=client",
    "verify:3-device": "bun run scripts/verify-3-device-preflight.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.828.0",
    "next-auth": "^4.24.11",
    "react-icons": "^5.5.0",
    "turbo": "^2.4.4"
  }
}
